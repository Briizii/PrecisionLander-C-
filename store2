#include <opencv2/opencv.hpp>
#include <iostream>
#include <aruco/aruco.h>
#include <aruco/fractaldetector.h>
#include <aruco/marker.h>
#include <filesystem>

cv::Mat __resize(const cv::Mat& in, int width)
{
    if (in.size().width <= width)
        return in;
    float yf = float(width) / float(in.size().width);
    cv::Mat im2;
    cv::resize(in, im2, cv::Size(width, static_cast<int>(in.size().height * yf)));
    return im2;
}

static std::array<cv::Point2f,4> orderCorners(const std::vector<cv::Point2f>& c) {
    // c has 4 points
    std::array<cv::Point2f,4> out;

    // TL has smallest (x+y), BR has largest (x+y)
    // TR has smallest (x-y), BL has largest (x-y)
    cv::Point2f tl, tr, br, bl;
    float minSum = 1e9, maxSum = -1e9, minDiff = 1e9, maxDiff = -1e9;

    for (auto& p : c) {
        float sum  = p.x + p.y;
        float diff = p.x - p.y;
        if (sum  < minSum) { minSum = sum;  bl = p; }
        if (sum  > maxSum) { maxSum = sum;  tr = p; }
        if (diff < minDiff){ minDiff = diff; br = p; }
        if (diff > maxDiff){ maxDiff = diff; tl = p; }
    }

    out[0]=tl; out[1]=tr; out[2]=br; out[3]=bl;
    return out;
}

int main() {
    try
    {
        // Memory allocation
        aruco::CameraParameters CamParam;
        cv::Mat InImage;
        std::string filename = "camera_result.xml";
        // read marker size
        float MarkerSize = 0.01;
        aruco::FractalDetector FDetector;
        FDetector.setConfiguration("FRACTAL_3L_6");
        int frameId = 0;
        char key = 0;
        int waitTime=10;
        bool havePose = false;
        double Z = 0;
        auto LastHudUpdate = std::chrono::steady_clock::now();
        static std::string hudText = "Frame: -- | Z: --m";

        cv::Mat overlay = cv::imread("overlay_image.png", cv::IMREAD_UNCHANGED); // BGRA if PNG has alpha
        if (overlay.empty()) {
            std::cerr << "Error: Could not read overlay image." << std::endl;
            return -1;
        }

        // Check camera files exist and are valid.
        if (std::filesystem::exists(filename)) {
            std::cout << "Camera calibration file exists!" << std::endl;
            CamParam.readFromXMLFile("camera_result.xml");
            if (CamParam.CameraMatrix.empty() || CamParam.Distorsion.empty()) {
                std::cerr << "Error: Camera matrices are empty. Check camera_result.xml file content." << std::endl
                          << "Use the camera calibration script in the included Aruco library to generate." << std::endl;
                return -1;
            }
            std::cout << CamParam.CameraMatrix << ", " << CamParam.Distorsion << std::endl;
        } else {
            std::cerr << "Camera calibration file does not exist in project directory" << std::endl;
            return -1;
        }

        // Open input and read image
        cv::VideoCapture camera(1); // 1 for laptop, 0 for phone

        if (camera.isOpened()) {
            std::cout << std::endl
                      << "Camera Open!" << std::endl
                      << "Press 'ETC' to cancel" << std::endl;
            camera >> InImage;
        } else {
            std::cerr << "Could not open input" << std::endl;
            return -1;
        }

        if (CamParam.isValid())
        {
            CamParam.resize(InImage.size());
            FDetector.setParams(CamParam, MarkerSize);
        }

        while (key != 27) {
            if (!camera.read(InImage) || InImage.empty()) {
                break;
            }
            // std::cout << "\r\rFrameId: " << frameId++ << std::flush;
            camera.retrieve(InImage);

            try {
                // Ok, let's detect
                if(FDetector.detect(InImage)) {
                    FDetector.drawMarkers(InImage);
                    auto Markers = FDetector.getMarkers();
                    if (!Markers.empty()) {
                        // Source corners (overlay image)
                        float w = float(overlay.cols - 1);
                        float h = float(overlay.rows - 1);
                        std::vector<cv::Point2f> src = { {0,0}, {w,0}, {w,h}, {0,h} };

                        // Destination corners (marker corners) — reorder!
                        auto dstA = orderCorners(Markers[0]);
                        std::vector<cv::Point2f> dst = { dstA[0], dstA[1], dstA[2], dstA[3] };

                        // Homography and warp
                        cv::Mat H = cv::findHomography(src, dst);
                        cv::Mat overlayBGR, overlayA;
                        if (overlay.channels() == 4) {
                            cv::cvtColor(overlay, overlayBGR, cv::COLOR_BGRA2BGR);
                            cv::extractChannel(overlay, overlayA, 3); // alpha channel 0..255
                        } else {
                            overlayBGR = overlay;
                            overlayA = cv::Mat(overlay.size(), CV_8UC1, cv::Scalar(255));
                        }

                        cv::Mat warpedBGR, warpedA;
                        cv::warpPerspective(overlayBGR, warpedBGR, H, InImage.size(), cv::INTER_LINEAR, cv::BORDER_CONSTANT);
                        cv::warpPerspective(overlayA,  warpedA,  H, InImage.size(), cv::INTER_NEAREST, cv::BORDER_CONSTANT);

                        warpedBGR.copyTo(InImage, warpedA);  // alpha acts as mask

                        //Pose estimation
                        try {
                            bool safeForPose = !Markers.empty() && Markers[0].size() == 4;
                            if(safeForPose && FDetector.poseEstimation()){
                            cv::Mat tvec = FDetector.getTvec();

                            // Validate tvec is usable: 3x1 or 1x3, and floating type
                            if (tvec.empty()) {
                                // treat as no pose this frame
                            } else {
                                // Convert to CV_64F so at<double> is safe
                                if (tvec.type() != CV_64F) {
                                    tvec.convertTo(tvec, CV_64F);
                                }

                                // Accept 3x1 or 1x3
                                double tx, ty, tz;
                                if (tvec.rows == 3 && tvec.cols == 1) {
                                    tx = tvec.at<double>(0, 0);
                                    ty = tvec.at<double>(1, 0);
                                    tz = tvec.at<double>(2, 0);
                                } else if (tvec.rows == 1 && tvec.cols == 3) {
                                    tx = tvec.at<double>(0, 0);
                                    ty = tvec.at<double>(0, 1);
                                    tz = tvec.at<double>(0, 2);
                                } else {
                                    // unexpected shape; skip this frame
                                    throw std::runtime_error("Unexpected tvec shape");
                                }

                                Z = std::sqrt(tx*tx + ty*ty + tz*tz);
                                havePose = true;
                            }
                            }
                        } catch (const cv::Exception& e) {
                            std::cerr << "Frame skipped (OpenCV): " << e.what() << std::endl;
                        }

                    }
                }
            } catch (const cv::Exception& e) {
                std::cerr << "OpenCV exception in detect(): " << e.what() << "\n";
            }

            // put important info on the video stream at 1Hz to reduce overhead.
            auto now = std::chrono::steady_clock::now();
            if (now - LastHudUpdate > std::chrono::milliseconds(1000)) {
                std::ostringstream ss;
                ss << "Frame: " << frameId
                   << " | Z: " << std::fixed << std::setprecision(2)
                   << (havePose ? Z : -1.0) << "m";
                hudText = ss.str();
                LastHudUpdate = now;
                havePose = false;
            }
            cv::putText(InImage, hudText, {20, 30}, cv::FONT_HERSHEY_SIMPLEX, 0.8,
            cv::Scalar(255,255,255), 2, cv::LINE_AA);
            cv::imshow("in", __resize(InImage, 1800));

            key = cv::waitKey(waitTime);  // wait for key to be pressed (essential for opencv to function)
            if (key == 's')
                waitTime = waitTime == 0 ? 10 : 0;
        }
    }
    catch (std::exception& ex)
    {
        std::cout << "Exception :" << ex.what() << std::endl;
    }
}
