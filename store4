                FDetector.drawMarkers(frame); // draws the corners (disable in flight)

                // std::cout << markers[0] << std::endl;
/************************************************************
* REMOVE BEFORE FLIGHT END
************************************************************/
                std::vector<cv::Point2f> img_pts = markers[0];
                bool ok = cv::solvePnP(
                    obj_pts,
                    img_pts,
                    camMatrix,
                    distCoeffs,
                    rvec,
                    tvec,
                    false,
                    cv::SOLVEPNP_IPPE_SQUARE
                );
                if (ok) {
                    double tx = tvec.at<double>(0,0);
                    double ty = tvec.at<double>(1,0);
                    double tz = tvec.at<double>(2,0);
                    double distance = sqrt(pow(tx,2) + pow(ty, 2) + pow(tz,2));
                    std::snprintf(buf, sizeof(buf), "\r x = %8.3fm | y= %8.3fm | z = %8.3fm | Distance = %8.3fm   ", tx, ty, tz, distance);
                    std::cout << buf << std::flush;
                    // cv::drawFrameAxes(frame, camMatrix, distCoeffs, rvec, tvec, 0.05f);
                } else {
                    FDetector.draw2d(frame); // draws the points (disable in flight
                }
                ok=false;
            }
        } else {
                //std::cerr << "No ArUco in FOV" << std::endl;
                // do nothing atm
        } // end of loop while a marker is detected


        // return corners for each id

        // if ids is not None and desired tag is in ids.flatten()
            // return the corners of the desired marker
            // create obj_points
            // create img_points by reshaping corners
            // return success, tvec and rvec

            // if success
                // assign x, y, z and change posvalid to 1
            // if pos is valid
                // print the translation in serial

        // print the image
        cv::imshow("in", frame);
        key = cv::waitKey(waitTime);  // wait for key to be pressed (essential for opencv to function)
        if (key == 's')
            waitTime = waitTime == 0 ? 10 : 0;

    } // ------------------------------------end of main loop------------------------
} // end of main function