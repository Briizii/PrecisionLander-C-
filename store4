#include <opencv2/opencv.hpp>
#include <iostream>
#include <aruco/aruco.h>
#include <aruco/fractaldetector.h>
#include <aruco/marker.h>
#include <filesystem>

//start of main function
int main() {
    // announce program start
    std::cout << "Starting ArUco Detection!" << std::endl;

    // data init
    const std::string filename = "camera_result.xml";
    int frameId = 0;
    const float MarkerSize = 0.01;
    char key = 0;
    int waitTime=10;
    const float s = MarkerSize * 0.5f;
    char buf[128];

    // define the world points (obj_pts)
    const std::vector<cv::Point3f> obj_pts = {
        {-s, +s, 0.0f},
        {+s, +s, 0.0f},
        {+s, -s, 0.0f},
        {-s, -s, 0.0f},
    };

    // aruco init
    aruco::FractalDetector FDetector;
    FDetector.setConfiguration("FRACTAL_3L_6");
    aruco::CameraParameters CamParam;
    cv::Mat rvec, tvec;
    cv::Mat camMatrix;
    cv::Mat distCoeffs;

    // --------------------------- camera init -----------------------------
    cv::Mat frame;
    // Check camera files exist and are valid.
    if (std::filesystem::exists(filename)) {
        std::cout << "Camera calibration file exists!" << std::endl;
        CamParam.readFromXMLFile("camera_result.xml");
        if (CamParam.CameraMatrix.empty() || CamParam.Distorsion.empty()) {
            std::cerr << "Error: Camera matrices are empty. Check camera_result.xml file content." << std::endl
                      << "Use the camera calibration script in the included Aruco library to generate." << std::endl;
            return -1;
        }
        std::cout << CamParam.CameraMatrix << ", " << CamParam.Distorsion << std::endl;
    } else {
        std::cerr << "Camera calibration file does not exist in project directory" << std::endl;
        return -1;
    }
    // Open input and read image
    cv::VideoCapture camera;
    camera.open(1); // 1 for laptop, 0 for phone
    if (camera.isOpened()) {
        std::cout << std::endl
                  << "Camera Open!" << std::endl
                  << "Press 'ETC' to cancel" << std::endl;
        camera >> frame; //first frame will be lost if main loop is entered.
    } else {
        std::cerr << "Could not open input" << std::endl;
        return -1;
    }

    if (CamParam.isValid())
    {
        CamParam.resize(frame.size());
        FDetector.setParams(CamParam, MarkerSize);
        camMatrix = CamParam.CameraMatrix;
        distCoeffs = CamParam.Distorsion;
    }

    // --------------------------------main loop---------------------------------------
    while (camera.isOpened() && key != 27) {
        //std::cout << "\r\rFrameId: " << frameId++ << std::flush;
        camera >> frame; // grab and retrieve, same as read (>>) function
        if (!camera.read(frame) || frame.empty()) { // check
            std::cerr << "Invalid frame received\n";
            continue;
        }

        // Detect markers and return to serial for testing
        if (FDetector.detect(frame)) {
            auto markers = FDetector.getMarkers();
            if (markers.empty()) {
                std::cerr << "Markers are empty" << std::endl;
            } else {
